{
  "name": "poke-color",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "vite --port 24340",
    "config": "node functions/createZukan.cjs",
    "prebuild": "npm run lint && npm run typecheck",
    "build": "vite-ssg build",
    "start": "vite preview --port 24340",
    "proxy": "ngrok http 24340 -hostname=pokecolor.jp.ngrok.io -region jp",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postbuild": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@googleapis/sheets": "^18.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.3.12"
  },
  "type": "module"
}
